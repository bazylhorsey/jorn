{
    "type": "package",
    "name": "bazylhorsey/jorn",
    "summary": "Pure Elm virtual DOM with a diff and patch protocol for server components",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Jorn",
        "Jorn.Attribute",
        "Jorn.Element",
        "Jorn.Element.Html",
        "Jorn.Element.Keyed",
        "Jorn.Element.MathMl",
        "Jorn.Element.Svg",
        "Jorn.Effect",
        "Jorn.Event",
        "Jorn.Navigation",
        "Jorn.Patch",
        "Jorn.ServerComponent",
        "Jorn.Static"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.1.0 <= v < 2.0.0",
        "elm/url": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
